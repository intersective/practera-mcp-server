{
  "name": "practera-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Practera GraphQL API with OAuth 2.1 support",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "start:stdio": "node dist/stdio.js",
    "dev": "tsx watch src/server.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "build": "tsc && cp -r src/data dist/",
    "typecheck": "tsc --noEmit",
    "activity": "tsx src/cli.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "deploy": "serverless deploy"
  },
  "keywords": [
    "mcp",
    "practera",
    "graphql",
    "ai",
    "llm",
    "oauth"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "graphql-request": "^6.1.0",
    "jose": "^5.9.6",
    "serverless-http": "^3.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.0.0",
    "serverless": "^4.36.1",
    "serverless-offline": "^14.7.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
